# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不要提交真实凭据）
DATABASE_URL=postgres://<用户名>:<密码>@127.0.0.1:5432/redstation
PORT=3001
HOST=0.0.0.0
# 生产环境务必替换为随机长字符串
JWT_SECRET=[redacted]
JWT_EXPIRES_IN=7d
DB_POOL_MAX=10

# ===== Redis（注册验证码）=====
# 验证码按 email 存 key，默认 5 分钟过期，服务端无需持久化
REDIS_URL=redis://127.0.0.1:6379

# ===== 邮件（注册验证码发信）=====
# 以 QQ 邮箱为例：设置 → 账户 → 开启 SMTP 服务，拿到「授权码」（不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<你的邮箱>@qq.com
SMTP_PASS=<SMTP 授权码>
SMTP_FROM=RedStation <<你的邮箱>@qq.com>
# 验证码有效期（秒），与前端提示文案保持一致
EMAIL_CODE_TTL=300
